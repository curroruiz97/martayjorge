# Variables de entorno de la web de Marta y Jorge (confirmaciones de asistencia).
#
# EN PRODUCCIÓN se configuran en Vercel → Settings → Environment Variables (no en este fichero).
# EN LOCAL (opcional, solo para probar contra el Supabase real): copia este fichero como .env,
# rellénalo y ejecuta «node scripts/dev.mjs». Para probar sin Supabase: «npm run dev».
# .env está en .gitignore: nunca subas claves a GitHub. Guía completa: docs/rsvp.md

# Dirección del proyecto: Supabase → botón «Connect» o Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave SECRETA (empieza por sb_secret_): Project Settings → API Keys → Secret keys.
# Solo para el servidor: nunca en el navegador ni en el código.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Alternativa antigua (JWT «service_role», empieza por eyJ). Supabase la retira a finales de 2026:
# usa SUPABASE_SECRET_KEY. Si están las dos, manda SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# Contraseña del panel /admin (mínimo 12 caracteres). Sin ella, el panel no existe (404).
ADMIN_TOKEN=cambia-esto-por-una-contraseña-larga

# Opcional: protege /api/ping (el cron diario que evita que Supabase pause el proyecto).
# CRON_SECRET=
